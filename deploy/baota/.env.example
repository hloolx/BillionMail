# Copy this file to /opt/BillionMail/.env and replace every CHANGE_ME value.

ADMIN_USERNAME=CHANGE_ME_ADMIN_USER
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SafePath=CHANGE_ME_SAFE_PATH

BILLIONMAIL_HOSTNAME=mail.oai.sb

DBNAME=billionmail
DBUSER=billionmail
DBPASS=CHANGE_ME_32_CHAR_DB_PASSWORD
REDISPASS=CHANGE_ME_32_CHAR_REDIS_PASSWORD

SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
REDIS_PORT=127.0.0.1:26379
SQL_PORT=127.0.0.1:25432

HTTP_PORT=80
HTTPS_PORT=443

WEB_BASE_PATH=
AAPANEL_SSO_SECRET=
TZ=Asia/Singapore
IPV4_NETWORK=172.66.1
FAIL2BAN_INIT=y
IP_WHITELIST_ENABLE=false
RETENTION_DAYS=7
